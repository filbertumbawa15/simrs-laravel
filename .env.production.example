# =============================================================================
# SIHRS - Template .env untuk PRODUCTION
# =============================================================================
# Cara pakai di server:
#   cp .env.production.example .env
#   nano .env  (isi semua yang bertanda "GANTI:")
#   php artisan key:generate --force
#   php artisan config:cache
#
# WAJIB ubah semua yang bertanda "GANTI:" sebelum go-live.
# Baris komentar boleh dihapus setelah setup selesai (biar env lebih ringkas).
# =============================================================================


# =============================================================================
# APLIKASI
# =============================================================================
APP_NAME="SIHRS"
APP_ENV=production
APP_KEY=                                 # GANTI: jalankan `php artisan key:generate --force`
APP_DEBUG=false                          # WAJIB false — production tidak boleh expose stack
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://sihrs.namars.id          # GANTI: URL production Anda (harus HTTPS)
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12                         # 12 = ~250ms/hash, cukup aman untuk 2026


# =============================================================================
# LOGGING
# =============================================================================
LOG_CHANNEL=daily                        # daily rotation, retensi 14 hari default
LOG_STACK=single,daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning                        # production: warning (bukan debug — hemat disk)
LOG_DAILY_DAYS=14


# =============================================================================
# DATABASE (MySQL 8+ / MariaDB 10.6+)
# =============================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sihrs                        # GANTI kalau pakai nama DB lain
DB_USERNAME=sihrs_app                    # GANTI: JANGAN pakai user root di production
DB_PASSWORD=                             # GANTI: password kuat, min 20 char


# =============================================================================
# SESSION & SECURITY (WAJIB set semua ini untuk production)
# =============================================================================
SESSION_DRIVER=database                  # atau 'redis' kalau ada Redis
SESSION_LIFETIME=120                     # menit — 2 jam default
SESSION_ENCRYPT=true                     # WAJIB — session bisa berisi data pasien
SESSION_SECURE_COOKIE=true               # WAJIB — cookie hanya via HTTPS
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null                      # atau '.namars.id' kalau ada subdomain


# =============================================================================
# QUEUE (untuk kirim email kritis async)
# =============================================================================
QUEUE_CONNECTION=database                # atau 'redis' kalau ada Redis
BROADCAST_CONNECTION=log


# =============================================================================
# CACHE
# =============================================================================
CACHE_STORE=database                     # atau 'redis' kalau ada
CACHE_PREFIX=sihrs


# =============================================================================
# REDIS (opsional tapi recommended untuk RS aktif)
# =============================================================================
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null                      # GANTI kalau Redis butuh auth
REDIS_PORT=6379


# =============================================================================
# FILESYSTEM (untuk upload radiologi, foto pasien, backup)
# =============================================================================
FILESYSTEM_DISK=local
# Kalau pakai S3/Wasabi untuk file besar (radiologi DICOM), isi:
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-southeast-1
# AWS_BUCKET=sihrs-storage


# =============================================================================
# EMAIL — notifikasi hasil lab/radiologi kritis ke DPJP
# =============================================================================
# Pilih 1: SMTP tradisional, atau Mailtrap/SES/Postmark
MAIL_MAILER=smtp                         # GANTI dari 'log' ke 'smtp'
MAIL_HOST=smtp.gmail.com                 # atau smtp.office365.com, mailgun, dst
MAIL_PORT=587
MAIL_USERNAME=                           # GANTI
MAIL_PASSWORD=                           # GANTI: app password, BUKAN password akun
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@sihrs.namars.id"   # GANTI
MAIL_FROM_NAME="${APP_NAME}"


# =============================================================================
# BACKUP (dipakai artisan sihrs:backup, jadwal jam 02:00)
# =============================================================================
BACKUP_PATH=/var/backups/sihrs           # GANTI: path yang punya cukup disk
BACKUP_KEEP_DAYS=30                      # retensi lokal — offsite backup terpisah


# =============================================================================
# SENTRY - Error monitoring
# =============================================================================
# Bikin project di sentry.io atau self-host GlitchTip.
# Kalau DSN kosong, package no-op (tidak error, tapi tidak kirim laporan).
SENTRY_LARAVEL_DSN=                      # GANTI: DSN dari Sentry project
SENTRY_TRACES_SAMPLE_RATE=0.1            # 10% request di-trace (kompromi performa vs visibility)
SENTRY_SEND_DEFAULT_PII=false            # WAJIB false — jangan kirim PHI ke Sentry
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=                          # opsional: git hash release, kalau CI di-set


# =============================================================================
# ACTIVITY LOG - Audit trail (Permenkes 269/2008)
# =============================================================================
ACTIVITY_LOGGER_ENABLED=true             # WAJIB true untuk produksi
ACTIVITY_LOGGER_RETENTION_DAYS=1825      # 5 tahun (Permenkes)


# =============================================================================
# SIHRS - Identitas Rumah Sakit (untuk kop dokumen, PDF, email)
# =============================================================================
SIHRS_RS_NAMA="RS Sehat Sentosa"                 # GANTI
SIHRS_RS_ALAMAT="Jl. Merdeka No. 123, Medan"     # GANTI
SIHRS_RS_TELP="(061) 1234567"                    # GANTI
SIHRS_RS_EMAIL="info@sihrs.namars.id"            # GANTI
SIHRS_RS_WEBSITE=                                # opsional
SIHRS_RS_KODE="3275001"                          # GANTI: kode RS (dari Kemenkes)
SIHRS_RS_IZIN=                                   # GANTI: no. izin operasional Dinkes
SIHRS_RS_KELAS=C                                 # A / B / C / D
SIHRS_PDF_WATERMARK=true

# CC email untuk hasil lab/radiologi kritis (audit safety net)
# Format: email1@a.com,email2@b.com (pisah koma, tanpa spasi)
SIHRS_KRITIS_CC=                                 # contoh: komdik@sihrs.namars.id,manajer@sihrs.namars.id

# Base URL untuk QR verifikasi dokumen (default = APP_URL)
SIHRS_VERIFY_BASE_URL=                           # kosongkan kalau sama dengan APP_URL


# =============================================================================
# BPJS BRIDGING (nanti di-fill saat lulus staging V-Claim)
# =============================================================================
BPJS_VCLAIM_URL=
BPJS_VCLAIM_CONSID=
BPJS_VCLAIM_SECRET_KEY=
BPJS_VCLAIM_USER_KEY=


# =============================================================================
# SATUSEHAT KEMENKES (mandatory sejak 2023 — bisa nyusul kalau belum siap)
# =============================================================================
SATUSEHAT_BASE_URL=https://api-satusehat.kemkes.go.id
SATUSEHAT_AUTH_URL=https://api-satusehat.kemkes.go.id/oauth2/v1
SATUSEHAT_CLIENT_ID=
SATUSEHAT_CLIENT_SECRET=
SATUSEHAT_ORGANIZATION_ID=


# =============================================================================
# VITE BUILD
# =============================================================================
VITE_APP_NAME="${APP_NAME}"
